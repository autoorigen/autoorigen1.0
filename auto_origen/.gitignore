# Entorno virtual de Python
venv/
.venv/

# Caché de Python
__pycache__/
*.pyc

# Base de datos local (contiene datos de clientes: NO subir a GitHub)
data/*.db

# Fotos y videos de vehículos subidos desde el admin o la app móvil
data/uploads/*
!data/uploads/.gitkeep

# Variables secretas
.env

# App Android (AutoorigenInspect) — artefactos de build, no código
app-android/**/build/
app-android/**/.gradle/
app-android/**/.idea/
app-android/**/*.iml
app-android/**/local.properties
app-android/**/captures/
app-android/**/.cxx/

# Sistema
.DS_Store
